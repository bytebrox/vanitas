# Public contract address shown in the footer (CA + copy).
# Rebuild / redeploy after changing this — Next inlines NEXT_PUBLIC_* at build time.
NEXT_PUBLIC_DONATE_CA=0x1bfab31ae01a030ae600da4825389a60156952c1

# ---------------------------------------------------------------------------
# Marketplace (/market). Leave NEXT_PUBLIC_MARKET_ENABLED unset to keep the
# whole section hidden; the rest is only read once it is switched on.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_MARKET_ENABLED=false

# "testnet" (chain 46630) or "mainnet" (chain 4663).
MARKET_CHAIN=testnet

# Provider endpoint. The public RPC works for development but is rate limited.
ROBINHOOD_RPC_URL=

# Neon Postgres. Both names are injected verbatim by the Vercel Neon
# integration, so nothing has to be set by hand there. The pooled URL serves
# the app; migrations use the direct one, because DDL does not survive
# pgbouncer's transaction pooling.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# The three secrets below can be generated with
#   node scripts/market-secrets.mjs
# which writes them to a gitignored file ready to paste into the host.

# 32 bytes hex. Encrypts server key halves and finished private keys at rest.
# Rotating this makes every stored key unrecoverable.
MARKET_MASTER_KEY=

# 32 bytes hex. Signs the session cookie.
MARKET_SESSION_SECRET=

# 64 bytes hex. BIP32 master seed for the per-order deposit addresses. Those
# addresses also sign the onward transfer to the seller, so no platform wallet
# needs a balance. There is no commission and nothing to collect.
MARKET_HD_SEED=

# Price bounds in wei. Default floor is 0.001 ETH, ceiling 1000 ETH. Worth
# lowering the floor on a testnet, where the faucet hands out less than that.
MARKET_MIN_PRICE_WEI=
MARKET_MAX_PRICE_WEI=

# Comma separated wallet addresses allowed to list platform inventory.
MARKET_ADMIN_ADDRESSES=

# Shared secret for the settlement cron, sent as "Authorization: Bearer ...".
CRON_SECRET=
