{
  "name": "vanitas",
  "version": "1.10.0",
  "description": "Client-side vanity address forge CLI for Solana, EVM, Bitcoin, Tron, Aptos, Sui, TON, Cardano, and XRP (wallet, mint, CREATE, CREATE2)",
  "license": "MIT",
  "author": "bytebrox",
  "homepage": "https://vanitas.fun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytebrox/vanitas.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/bytebrox/vanitas/issues"
  },
  "keywords": [
    "vanity",
    "address",
    "solana",
    "ethereum",
    "bitcoin",
    "tron",
    "aptos",
    "sui",
    "ton",
    "cardano",
    "xrp",
    "xrpl",
    "cli"
  ],
  "type": "commonjs",
  "bin": {
